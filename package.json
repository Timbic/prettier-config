{
	"name": "@timbic/prettier-config",
	"type": "module",
	"version": "2.0.4",
	"private": false,
	"description": "Timbic's prettier configuration",
	"author": "Timur Bikmuhametov <tim.bic22@gmail.com>",
	"license": "MIT",
	"keywords": [
		"prettier",
		"prettier-config"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Timbic/prettier-config.git"
	},
	"exports": {
		".": "./dist/index.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"fmt": "prettier --cache --write .",
		"fmt:chk": "prettier --check .",
		"lint": "eslint --cache",
		"lint:fix": "eslint --cache --fix",
		"typecheck": "tsc --noEmit",
		"release": "bumpp",
		"prepare": "husky"
	},
	"dependencies": {
		"@prettier/plugin-oxc": "^0.2.4",
		"prettier": "^3.10.1",
		"prettier-plugin-astro": "^1.1.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"prettier-plugin-yaml": "^1.3.2"
	},
	"devDependencies": {
		"@timbic/eslint-config": "1.2.5",
		"bumpp": "12.3.0",
		"husky": "9.1.7",
		"lint-staged": "17.6.2",
		"tsdown": "0.23.7",
		"typescript": "6.0.3"
	},
	"lint-staged": {
		"*.{js,ts,md,json,yaml,yml}": [
			"prettier --write",
			"eslint --fix"
		]
	},
	"packageManager": "pnpm@12.23.0"
}
