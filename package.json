{
	"name": "@timbic/prettier-config",
	"type": "module",
	"version": "1.2.4",
	"private": false,
	"description": "Timbic's prettier configuration",
	"author": "Timur Bikmuhametov <tim.bic22@gmail.com>",
	"license": "MIT",
	"keywords": [
		"prettier",
		"prettier-config"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Timbic/prettier-config.git"
	},
	"exports": {
		".": "./dist/index.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"fmt": "prettier --cache --write .",
		"fmt:chk": "prettier --check .",
		"lint": "eslint --cache",
		"lint:fix": "eslint --cache --fix",
		"typecheck": "tsc --noEmit",
		"release": "bumpp",
		"prepare": "husky"
	},
	"peerDependencies": {
		"prettier": "^3.0.0"
	},
	"peerDependenciesMeta": {
		"prettier": {
			"optional": true
		}
	},
	"devDependencies": {
		"@timbic/eslint-config": "1.2.2",
		"@types/node": "26.6.5",
		"bumpp": "12.3.0",
		"eslint": "10.13.0",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"prettier": "3.9.10",
		"tsdown": "0.23.2",
		"typescript": "6.0.3"
	},
	"lint-staged": {
		"*.{js,ts,md,json}": [
			"prettier --write",
			"eslint --fix"
		]
	},
	"packageManager": "pnpm@12.14.0"
}
